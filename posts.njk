---
title: Posts
coverImage: https://static.goblinoid.co.uk/jeff-horton.uk/home-cover.jpg
breadcrumbs:
  - label: Home
    url: /
  - label: Posts
css: posts
---

{% for post in collections.postsByDate %}
  <article class="post-preview">
    {% if post.data.image %}
      <a href="{{ post.url }}">
        <img src="{{ post.data.image }}" alt="{{ post.data.title }}"/>
      </a>
    {% endif %}
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <time datetime="{{ post.date | date('yyyy-MM-dd') }}">
      {{ post.date | date('d MMM YYYY') }}
    </time>
    <div class="summary">
      {{ post.data.summary }}
    </div>
    {%if post.data.tags %}
      <div class="tags">
        Tags:
        {% for tag in post.data.tags | reject("eq", "post") %}
          <a href="/tags/{{ tag | slug }}/" class="tag">{{ tag }}</a>{% if not loop.last %}, {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </article>
{% endfor %}
